# 所有环境共享的默认配置（会被 .env.<mode> 和 .env.<mode>.local 覆盖）

# 系统名称（用于页面标题、侧边栏 Logo、登录页标题、index.html <title>）
VITE_APP_TITLE=SMO Admin
# 系统描述（用于 index.html <meta description>）
VITE_APP_DESCRIPTION=SMO Admin - 后台管理系统

# API 请求前缀，默认 /api（与 vite proxy 的 /api 规则对应）
VITE_API_PREFIX=/api

# CSRF token 注入开关
# - false（默认）：前端不注入 CSRF token
# - true：每次请求自动从 cookie XSRF-TOKEN 读取（读不到则调 /auth/csrf），
#         注入到 X-XSRF-TOKEN 请求头
# 后端启用 CSRF 校验后改为 true；也可运行时调用 setCsrfEnabled(true) 开启
VITE_CSRF_ENABLED=false

# 鉴权 token 注入开关
# - true（默认）：从 localStorage 读取 token，注入到 Authorization: Bearer 头
# - false：不注入 Authorization 头（适用于无鉴权后端 / 公共接口场景）
# 也可运行时调用 setTokenEnabled(false) 关闭
VITE_TOKEN_ENABLED=false
